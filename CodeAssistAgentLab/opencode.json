                                                      "webfetch":  "allow",
                                                      "bash":  "allow"
                                                  }
                               },
                  "tester":  {
                                 "description":  "Writes and runs tests against the implemented feature, then reports what actually failed.",
                                 "mode":  "all",
                                 "model":  "ollama/qwen2.5-coder:1.5b",
                                 "prompt":  "{file:./.opencode/prompt/tester.md}",
                                 "temperature":  0.1,
                                 "permission":  {
                                                    "edit":  "allow",
                                                    "webfetch":  "allow",
                                                    "bash":  "allow"
                                                }
                             }
              },
    "plugin":  [
