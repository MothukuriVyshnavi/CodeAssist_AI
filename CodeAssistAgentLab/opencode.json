                                   "model":  "ollama/qwen2.5-coder:1.5b",
                                   "prompt":  "{file:./.opencode/prompt/reviewer.md}",
                                   "temperature":  0,
                                   "tools":  {
                                                 "edit":  false,
                                                 "patch":  false,
                                                 "write":  true
